# Generate a long, random value for production and configure it in Render.
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Add your Vercel deployment URL here (no trailing slash).
CORS_ORIGINS=https://your-vercel-project.vercel.app

# Render supplies this from its managed PostgreSQL database.
DATABASE_URL=postgresql://username:password@host:5432/database
